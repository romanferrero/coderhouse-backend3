# Variables del entorno de testing (npm test). Copiar a .env.test.
# Puerto que figura en la documentación de Swagger. Los tests no abren este puerto:
# Supertest levanta la app en un puerto temporal.
PORT=8081
# Base de datos SOLO para tests: se vacía antes de cada test. El nombre tiene que contener "test".
MONGODB_URI=mongodb://localhost:27017/shipnow_test
# Tiene que ser test
NODE_ENV=test
