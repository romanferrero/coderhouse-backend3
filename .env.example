# Variables del entorno de DESARROLLO (npm run dev / npm start). Copiar a .env y completar.
# Ver también .env.test.example (tests) y .env.production.example (producción / Docker).

# ---------- Obligatorias: la app no arranca si falta alguna ----------
# Puerto donde escucha el servidor HTTP (1-65535)
PORT=8080
# URI de conexión a MongoDB. Si tiene usuario y contraseña, nunca se sube al repositorio.
MONGODB_URI=mongodb://localhost:27017/shipnow
# Entorno de ejecución: development | production | test
NODE_ENV=development

# ---------- Opcionales ----------
# Nivel mínimo de logs: fatal | error | warning | info | http | debug
# Vacío = el del entorno (development: debug, production: info, test: warning)
LOG_LEVEL=
# URL pública de la API, la que muestra Swagger. Vacío = http://localhost:<PORT>
PUBLIC_URL=
# Documentación Swagger en /api/docs: true | false. Vacío = true
SWAGGER_ENABLED=
