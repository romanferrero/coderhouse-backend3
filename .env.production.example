# Variables del entorno de PRODUCCIÓN. Copiar a .env.production y completar con los valores reales.
# - Local: NODE_ENV=production npm start lee este archivo.
# - Docker: docker run --env-file .env.production ... (el archivo nunca entra en la imagen).
# Nunca se sube al repositorio: tiene la URI real de la base, con sus credenciales.

# ---------- Obligatorias: la app no arranca si falta alguna ----------
# Dentro del contenedor la API escucha en 8080 (el puerto que expone el Dockerfile).
# Para usar otro puerto del host se cambia el mapeo (-p 3000:8080), no esta variable.
PORT=8080
# MongoDB Atlas (mongodb+srv://usuario:contraseña@cluster.mongodb.net/shipnow) o, para probar el
# contenedor contra el MongoDB instalado en la máquina: mongodb://host.docker.internal:27017/shipnow
MONGODB_URI=
NODE_ENV=production

# ---------- Opcionales ----------
# info registra eventos importantes, advertencias y errores. http agrega una línea por request.
LOG_LEVEL=info
# URL pública donde se publica la API (la que muestra Swagger). Vacío = http://localhost:<PORT>
PUBLIC_URL=
# Swagger en producción: true (por defecto) o false para no publicar la documentación.
SWAGGER_ENABLED=true
